    "fixation": {
      "description": "Fixation pump stations and public work stands.",
      "counting_method": "Count 26xxx SKUs. These are typically accessory items that ride along.",
      "primary_skus": [
        {"pattern": "26240*", "note": "HSO Pump"},
        {"pattern": "26246*", "note": "HSO Pump Floor Mount"},
        {"pattern": "26248*", "note": "HSI Pump Short Hose Floor Mount"},
        {"pattern": "26252*", "note": "HSI Pump Repair Stand Mount"},
        {"pattern": "26263*", "note": "Electric Public Bike Pump"},
        {"pattern": "26268*", "note": "Public Work Stand Install Kit"},
        {"pattern": "26302*", "note": "Public Workstand (all variants: C, S, G, BLK, RED, ORG)"},
        {"pattern": "26347*", "note": "Deluxe Public Workstand"},
        {"pattern": "26296*", "note": "Fixation accessory"},
        {"pattern": "26299*", "note": "Fixation accessory"},
        {"pattern": "26859*", "note": "Fixation product"},
        {"pattern": "FX3-*", "note": "Fixation product"}
      ],
      "default_role": "accessory"
    },

    "custom_branded": {
      "description": "Custom branded products (college logos, etc).",
      "counting_method": "Count 40802-* SKUs.",
      "primary_skus": [
        {"pattern": "40802-*", "note": "Custom branded products (various institutions)"},
        {"pattern": "WWM-CUSTOM", "note": "Custom wall mount products"}
      ]
    }
  },

