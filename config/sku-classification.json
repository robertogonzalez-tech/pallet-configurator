        {"pattern": "90101-04*", "note": "VisiLocker/MBV box components (BOXA, BOXB, BOXC)"},
        {"pattern": "50101-04*", "note": "VisiLocker/MBV post components"}
      ]
    },

    "mba": {
      "description": "MBA (Multi-Bike Adapter) large bike racks.",
      "counting_method": "Count 89901-0335-* or MBA-specific SKUs.",
      "primary_skus": [
        {"pattern": "89901-0335-*", "note": "MBA assembled units"},
        {"pattern": "90101-0335-*", "note": "MBA components"},
        {"pattern": "85001-*", "note": "MBA/large format products"}
