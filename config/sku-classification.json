{
  "_version": "1.0",
  "_description": "SKU classification for Bauerworld package prediction engine. Each rule maps a SKU pattern to a product family and role.",
  "_roles": {
    "primary": "The main product - determines package count and template",
    "hardware": "Anchor kits, bolts, fasteners - ride along on primary product's pallet",
    "accessory": "Pumps, workstands, tools - may ship separately or ride along depending on size",
    "non_ship": "Discounts, fees, tax items, services - never ship physically"
  },

  "families": {
    "undergrad": {
      "description": "Undergrad bike racks (inverted-U style). Components: post + loop pairs. Sold as assemblies.",
      "counting_method": "Count primary SKUs. Each 80101-* or 80301-* pair = 1 rack unit.",
      "primary_skus": [
        {"pattern": "80101-*", "note": "Undergrad posts (all color variants)"},
        {"pattern": "80301-*", "note": "Undergrad loops (all color variants)", "exclude": ["80301-0301*", "80301-4*"]},
        {"pattern": "80101-*-KIT", "note": "Undergrad kit variants"}
      ],
      "known_variants": [
        "GAV (galvanized)", "BLK13 (black powder coat)", "BLK23 (black texture)",
        "GRY23 (gray texture)", "SS (stainless steel)", "CUST* (custom color)",
        "ZRP (zinc rich primer)", "RAW", "LEAN-* (lean rail variant)",
        "-T (with top rail)", "-DEL (deluxe)", "-USA (USA made)",
        "-FIRE (fire rated)", "-M (modified)"
      ]
    },

    "vr2_offset": {
      "description": "VR2 Offset bike racks. Main product + optional rail tubes.",
      "counting_method": "Count 90101-* SKUs for rack qty. Check for rail SKUs separately.",
      "primary_skus": [
        {"pattern": "90101-*", "note": "VR2 rack assemblies (all variants)"}
      ],
      "conditional_packages": [
        {"pattern": "50801-0012-*", "note": "Rail tubes - may ship as separate long tube package"},
        {"pattern": "50301-0062-*", "note": "Rail end caps - ship with rails"}
      ]
    },

    "hoop_runner": {
      "description": "Hoop Runner HR201 bike racks.",
      "counting_method": "Count primary SKUs.",
      "primary_skus": [
        {"pattern": "89901-0163-*", "note": "HR201 with chain and crossbar"},
        {"pattern": "89901-0162-*", "note": "HR201 variant"}
      ]
    },

    "dismount": {
      "description": "Dismount VR2 / DV215 bike racks. Embedded mount style.",
      "counting_method": "Count primary assembled product SKUs.",
      "primary_skus": [
        {"pattern": "89901-2287-*", "note": "DV215 assembled racks (all colors)"},
        {"pattern": "89901-2087-*", "note": "DV287 variant"},
        {"pattern": "DV215-*", "note": "DV215 custom variants"},
        {"pattern": "89901-0172-*", "note": "VR2 assembled (some overlap with vr2_offset)"},
        {"pattern": "89901-1172-*", "note": "VR2 embedded assembled"},
        {"pattern": "89901-0287-*", "note": "Dismount variant"}
      ]
    },

    "double_docker": {
      "description": "Double Docker DD units. Complex multi-component product.",
      "counting_method": "Count DD assembly SKUs. Components ship as separate crates at higher quantities.",
      "primary_skus": [
        {"pattern": "DD-*", "note": "Double Docker assemblies"},
        {"pattern": "DD14-*", "note": "DD 14-bike variant"},
        {"pattern": "DD16-*", "note": "DD 16-bike variant"}
      ],
      "component_skus": [
        {"pattern": "89901-1210-*", "note": "DD slides"},
        {"pattern": "89901-2014-*", "note": "DD manifold"},
        {"pattern": "89901-2024-*", "note": "DD component"},
        {"pattern": "89901-1308-*", "note": "DD component"},
        {"pattern": "89901-2004-*", "note": "DD component"},
        {"pattern": "89901-2037-*", "note": "DD component"},
        {"pattern": "61211-*", "note": "DD structural component"}
      ]
    },

    "skatedock": {
      "description": "Skatedock skateboard parking. Individual boxes at low qty, palletized at qty 3+.",
      "counting_method": "Count 89904-* (main unit) or 89914-* (components).",
      "primary_skus": [
        {"pattern": "89904-*", "note": "Skatedock main unit"},
        {"pattern": "89914-*", "note": "Skatedock components/kits"},
        {"pattern": "89901-1210-*-USA", "note": "Skatedock USA variant"}
      ],
      "fee_skus": [
        {"pattern": "Royalty Fee - Skatedock", "note": "Non-shipping fee line"}
      ]
    },

    "base_station": {
      "description": "Base Station bike parking rails. Various lengths.",
      "counting_method": "Count rail SKUs (50801-*). End caps (50301-*) are per-rail accessories.",
      "primary_skus": [
        {"pattern": "50801-*", "note": "Base Station rails (all lengths and finishes)"},
        {"pattern": "BS-RAIL-*", "note": "Base Station rail variants"},
        {"pattern": "BS-RACK-*", "note": "Base Station rack components"},
        {"pattern": "BS-CAP-*", "note": "Base Station caps"}
      ],
      "accessory_skus": [
        {"pattern": "50301-*", "note": "Rail end caps"},
        {"pattern": "50101-*", "note": "Base Station posts/components"}
      ]
    },

    "visilocker": {
      "description": "VisiLocker / Metal Bike Vault secure bike storage.",
      "counting_method": "Count LOCKER-* SKUs.",
