  "assembly_component_skus": {
    "_description": "SKUs that appear as assembly components (assemblyComponent = T). These are sub-parts of assembled products and should be excluded from the pick ticket.",
    "note": "These are already filtered by the assemblyComponent = F condition in the NetSuite query. Listed here for documentation only.",
    "patterns": [
      {"pattern": "60913-*", "note": "Sub-assembly component"},
      {"pattern": "80301-*-RAW", "note": "Raw material component"},
      {"pattern": "80301-0287-RAW", "note": "Raw component"},
      {"pattern": "71003-*", "note": "Service/non-shipping component"},
      {"pattern": "14*", "note": "Various internal components (14xxx range)"}
    ]
  },

  "classification_priority": [
    "1. Check non_ship_patterns first — exclude immediately",
    "2. Check assembly_component flag from NetSuite — exclude if assemblyComponent = T",
    "3. Check families in order: double_docker, visilocker, skatedock, base_station, vr2_offset, dismount, hoop_runner, undergrad, mba, sidestage, stretch_rack, fixation, custom_branded",
    "4. Check hardware_patterns — classify as ride-along",
    "5. Check third_party_products — use fallback weight-based prediction",
    "6. Anything remaining: log as UNKNOWN, use fallback"
  ]
}
